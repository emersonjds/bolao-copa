        "supabase/config.toml",
        "supabase/migrations/0004_auth_autoinscricao.sql",
        "supabase/migrations/0001_initial_schema.sql"
      ]
    },
    {
      "name": "CSP permite `script-src 'unsafe-inline'`",
      "paths": [
        "public/_headers"
      ]
    },
    {
      "name": "Tokens de sessão em cookie acessível a JavaScript (não-HttpOnly)",
      "paths": [
        "src/shared/lib/supabase/client.ts"
      ]
    },
    {
      "name": "`connect-src` da CSP usa wildcard `*.supabase.co`",
      "paths": [
        "public/_headers"
      ]
    },
    {
      "name": "`eh_admin(uuid)` permite enumerar contas admin",
      "paths": [
        "supabase/migrations/0023_eh_admin_sem_parametro.sql",
