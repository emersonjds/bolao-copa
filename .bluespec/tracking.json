    {
      "name": "`SENHA_DEV` hardcoded em escopo de módulo (pode vazar no bundle)",
      "paths": [
        "src/features/auth/components/dev-login-button.tsx"
      ]
    },
    {
      "name": "Chave publishable local hardcoded no `package.json`",
      "paths": [
        "package.json"
      ]
    },
    {
      "name": "MCP `serena` instalado sem pin de commit (supply chain de dev)",
      "paths": [
        ".mcp.json"
      ]
    },
    {
      "name": "Sem scanning de dependências no CI",
      "paths": [
        ".github/workflows/security.yml"
      ]
    },
    {
      "name": "`undici` transitivo com CVE (apenas dev/test)",
      "paths": [
        "pnpm-lock.yaml"
      ]
    }
  ]
}
