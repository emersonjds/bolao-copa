      "paths": [
        "package.json",
        "scripts/notificar.ts"
      ]
    },
    {
      "name": "`postcss` transitivo com CVE de XSS de build-time",
      "paths": [
        "package.json",
        "pnpm-lock.yaml"
      ]
    },
    {
      "name": "Ranking conta pontos de partida revertida para não-encerrada",
      "paths": [
        "supabase/migrations/0025_ranking_so_encerradas.sql",
        "tests/db/apurar-pontos.test.ts"
      ]
    },
    {
      "name": "`updated_at` de palpite falsificável pelo cliente",
      "paths": [
        "supabase/migrations/0026_palpite_updated_at_nao_gravavel.sql",
        "tests/db/apurar-pontos.test.ts"
      ]
    },
    {
